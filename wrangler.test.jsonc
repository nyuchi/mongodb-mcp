{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mongodb-mcp-test",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "test-oauth-kv"
    }
  ]
}
