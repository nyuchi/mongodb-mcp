{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mongodb-mcp",
  "main": "src/index.ts",
  "account_id": "125a2dfbc21f76a25c980609609e8218",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  // The MCP endpoint is stateless (agents' createMcpHandler), so the MongoMcp
  // Durable Object is gone. Deleting a DO class needs its own migration —
  // dropping the binding alone would leave the class orphaned.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MongoMcp"],
    },
    {
      "tag": "v2",
      "deleted_classes": ["MongoMcp"],
    },
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "5444b8773bc14eb78738c74f1d3c28ea",
    },
  ],
  // Preview URLs carry the beta: each merge into `staging` is uploaded as a
  // version (not deployed) under the alias `staging`, served at
  // staging-mongodb-mcp.nyuchi.workers.dev. Production stays on the route below.
  "preview_urls": true,
  "routes": [
    {
      "pattern": "mongodb.nyuchi.dev",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "alias": {
    "@mongodb-js/zstd": "./src/native-stub.js",
    "kerberos": "./src/native-stub.js",
    "mongodb-client-encryption": "./src/native-stub.js",
    "snappy": "./src/native-stub.js",
  },
  // WORKOS_AUTHKIT_DOMAIN is deliberately NOT a var here. It is REQUIRED and set
  // per environment as a Worker secret (owner script, 1Password nyuchi/workos) —
  // never committed, no default in code. Without it /authorize and /callback
  // answer 503 "WORKOS_AUTHKIT_DOMAIN is not configured".
  "vars": {
    "WORKOS_CLIENT_ID": "client_01KVTX0V2K1VM3PSC0DJ9VZWTV",
    "WORKOS_ORGANIZATION_ID": "org_01KRDAB894DJF5V38PT5617TV1",
    "WORKOS_ALLOWED_ORG_IDS": "org_01KRDAB894DJF5V38PT5617TV1",
    "WORKOS_REQUIRED_PERMISSION": "mongodb:access",
  },
  "dev": {
    "port": 8788,
  },
}
