    "mongodb": "^7.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261122.2",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vite-plus": "^1.7.0",
    "vitest": "^5.1.0",
